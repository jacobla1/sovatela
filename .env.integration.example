# Live integration-test keys. Copy this file to .env.integration and fill in.
#
#   cp .env.integration.example .env.integration
#
# .env.integration is gitignored — real keys are NEVER committed.
# Only providers with a key set are tested; the rest are skipped, so you can
# fill in as many or as few as you have accounts for.

# --- Chat (required for the chat + token-split tests) ---
# Scaleway Secret Key (Settings → Scaleway API key).
SCALEWAY_API_KEY=

# --- Web search ---
# Linkup API key (has a free tier).
LINKUP_API_KEY=
# Qwant Staan API key (business accounts).
STAAN_API_KEY=
# Self-hosted SearXNG: run it locally (Settings → Web search → "On this
# computer") and point here. Token only if your instance requires one.
SEARXNG_URL=
SEARXNG_TOKEN=

# --- Image generation (THESE BILL YOUR ACCOUNT) ---
# Generate ~1 image each, only when RUN_PAID_TESTS is also set to 1.
BFL_API_KEY=
OVH_API_KEY=
# Set to 1 to actually run the paid image tests above.
RUN_PAID_TESTS=
