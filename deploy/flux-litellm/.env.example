# Copy to .env and fill in.  (.env is gitignored; this example is not.)

# Your Black Forest Labs API key. Get one at https://bfl.ai and add credits —
# FLUX charges per image, billed to you.
BFL_API_KEY=your-bfl-api-key

# The token the app sends as its image "Access token". LiteLLM expects the
# master key to start with sk-. Generate one with:
#   echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-replace-with-a-random-token
